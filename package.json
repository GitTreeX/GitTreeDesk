{
  "name": "gitreedesk",
  "version": "0.4.0-alpha.2",
  "private": true,
  "description": "Workspace-first multi-repo Git workbench",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gitreedesk/desktop dev",
    "build": "pnpm --filter @gitreedesk/desktop build",
    "brand": "node scripts/generate-brand-assets.mjs",
    "fixture": "node scripts/generate-fixture-workspace.mjs",
    "screenshot:readme": "node examples/readme-screenshot/capture.mjs",
    "package": "pnpm --filter @gitreedesk/desktop package",
    "package:win": "pnpm --filter @gitreedesk/desktop package:win",
    "package:mac": "pnpm --filter @gitreedesk/desktop package:mac",
    "package:linux": "pnpm --filter @gitreedesk/desktop package:linux",
    "build:native": "node scripts/build-native.mjs",
    "docs:start": "pnpm --dir website start",
    "docs:build": "pnpm --dir website build",
    "docs:serve": "pnpm --dir website serve",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "perf-budget": "node scripts/perf-budget.mjs",
    "perf-graph": "node scripts/perf-graph.mjs",
    "postinstall": "node scripts/install-electron.mjs",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.node.json && tsc --noEmit -p apps/desktop/tsconfig.web.json && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/git-core && tsc --noEmit -p packages/workspace-core && tsc --noEmit -p packages/store && tsc --noEmit -p packages/terminal-core && tsc --noEmit -p packages/commit-msg",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
